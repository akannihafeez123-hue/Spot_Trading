# ═══════════════════════════════════════════════════════════════════════════
#  WYCKOFF-ONLY MODE — COMPLETE ENVIRONMENT
#  Wispbyte deployment · Apex-Blacklister.js
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# 1. TELEGRAM (required — admin single-owner mode)
# ─────────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE
ADMIN_USER_ID=YOUR_TELEGRAM_USER_ID_HERE
TELEGRAM_POLLING_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────
# 2. DATABASE (Neon — state_store + trade_journal persistence)
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_jb1ttQhLbafF@ep-dawn-brook-ao63kcce-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_HYDRATE_ON_BOOT=1
NEON_FLUSH_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────
# 3. HTTP CONTROL (Render/Wispbyte keep-alive + protected endpoints)
# ─────────────────────────────────────────────────────────────────────────
# Set this to enable POST /start /stop /scan /apex/scan /wyckoff/scan and
# GET /neon/status. Leave EMPTY to keep those endpoints disabled (503).
HTTP_CONTROL_TOKEN=
PORT=10000
SERVER_HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────
# 4. WYCKOFF INTRADAY SCANNER — THE ONLY ACTIVE SIGNAL ENGINE
# ─────────────────────────────────────────────────────────────────────────
WYCKOFF_ENGINE_ENABLED=1
WYCKOFF_TIMEFRAME=1h
WYCKOFF_HTF_TIMEFRAME=4h
WYCKOFF_CANDLE_LIMIT=180
WYCKOFF_SCAN_INTERVAL_MS=900000
WYCKOFF_SCAN_BATCH_SIZE=50
WYCKOFF_SCAN_CONCURRENCY=5
WYCKOFF_SCAN_SYMBOL_TIMEOUT_MS=25000
WYCKOFF_FORCE_SCAN_MAX_BATCH=150
WYCKOFF_MIN_SCORE=70
WYCKOFF_MIN_RR=2.0
WYCKOFF_STOP_ATR_BUFFER=0.9
WYCKOFF_ALERT_COOLDOWN_MS=43200000
WYCKOFF_MIN_INSTITUTIONAL_SCORE=55

# ── THE THREE CRITICAL OVERRIDES ─────────────────────────────────────────
# 1) Macro-2Y gate REMOVED — Wyckoff fires regardless of macro regime
WYCKOFF_REQUIRE_MACRO=0
# 2) PRE_BREAK entries ALLOWED — spring/upthrust leg armed before BOS
WYCKOFF_ALLOW_PRE_BREAK_ENTRY=1
# 3) RETEST entries ALLOWED — LPS retest leg armed after BOS
WYCKOFF_ALLOW_RETEST_ENTRY=1
# 4) Institutional footprint is ENRICHMENT, not a hard gate
WYCKOFF_REQUIRE_INSTITUTIONAL=0

# ── Trap Guard (this is the whole point of your detector — keep ON) ──────
WYCKOFF_TRAP_GUARD_ENABLED=1
WYCKOFF_TRAP_GUARD_WIRE=1
WYCKOFF_TRAP_HTF_TF=4h
WYCKOFF_TRAP_MACRO_TF=1day
WYCKOFF_TRAP_MACRO_MIN_CONVICTION=0
WYCKOFF_TRAP_MACRO_CACHE_MS=600000
WYCKOFF_TRAP_SWEEP_DEPTH_ATR=0.15
WYCKOFF_TRAP_SOS_BODY_RATIO=0.60
WYCKOFF_TRAP_SOS_VOLUME_RATIO=1.30
WYCKOFF_TRAP_SOS_EXPANSION_ATR=1.50
WYCKOFF_TRAP_RANGE_ATR_MULT=15
WYCKOFF_TRAP_MIN_RR=2.0
WYCKOFF_TRAP_STOP_ATR_BUFFER=0.80
WYCKOFF_TRAP_HTF_STOP_BUFFER_ATR=0.50
WYCKOFF_TRAP_HTF_STOP_MAX_DRIFT_PCT=5.0
WYCKOFF_TRAP_LPS_MAX_FRESHNESS=4
WYCKOFF_TRAP_LPS_SEARCH_BARS=12
WYCKOFF_TRAP_MIN_BARS=80
WYCKOFF_TRAP_RANGE_LOOKBACK=60
WYCKOFF_TRAP_RANGE_END_OFFSET=10
WYCKOFF_TRAP_MIN_RANGE_BARS=30
WYCKOFF_TRAP_BREAK_SEARCH_BARS=30

# ── Enrichment modules (annotate the card, never block the signal) ───────
WYCKOFF_UPGRADE_ENABLED=1
WYCKOFF_FOOTPRINT_ENABLED=1

# ── Swing Wyckoff engine — OFF (not requested) ───────────────────────────
WYCKOFF_SWING_ENGINE_ENABLED=0

# ─────────────────────────────────────────────────────────────────────────
# 5. EVERY OTHER AUTO-SCANNER — DISABLED
# ─────────────────────────────────────────────────────────────────────────
APEX_ONLY_AUTOMATION=0
APEX_ENGINE_ENABLED=0
APEX_SOVEREIGN_ENABLED=0
CONT_ENABLED=0
CONT2_ENABLED=0
AUTO_MAIN_BRAIN_ENABLED=0
MECH_EXECUTION_ENABLED=0
VAULT_AUTO_ENABLED=0
DECISION_AUTO_SCAN=false
INSTITUTIONAL_WATCH_INTERVAL_MS=0
BREAKOUT_ENABLED=0
BREAKOUT_DISCOVERY_ENABLED=0
AUTO_SCANNER_ENABLED=0
LIMITBOT_AUTO_ENABLED=0

# Legacy intervals stretched to 24h so a stray start() is effectively a no-op
WATCH_INTERVAL_MS=86400000
SCAN_INTERVAL_MS=86400000
DAILY_PIPELINE_MS=86400000
ANALYSIS_INTERVAL_MS=86400000

# ─────────────────────────────────────────────────────────────────────────
# 6. KERAS BRAIN — disabled (frees RAM; Wyckoff doesn't need predictions)
# ─────────────────────────────────────────────────────────────────────────
KERAS_BRAIN_DISABLED=1

# ─────────────────────────────────────────────────────────────────────────
# 7. ACCOUNT / TRADING MODE (used only for sizing math on cards)
# ─────────────────────────────────────────────────────────────────────────
ACCOUNT_BALANCE=10
ACCOUNT_RISK_PERCENT=2.0
MARKET_TYPE=futures
FUTURES_LEVERAGE=5
FX_LEVERAGE=30
QUANTUM_RR=3.2
MAX_POSITION_SIZE=10
SIGNAL_THRESHOLD=75

# ─────────────────────────────────────────────────────────────────────────
# 8. WATCHLIST / UNIVERSE
# ─────────────────────────────────────────────────────────────────────────
MAX_SYMBOLS_WATCH=500
MIN_SYMBOL_VOLUME=1000000
SYMBOL_REFRESH_MS=21600000

# ─────────────────────────────────────────────────────────────────────────
# 9. LOW-BANDWIDTH — OFF (Wyckoff needs full candle history)
# ─────────────────────────────────────────────────────────────────────────
LOW_BANDWIDTH_MODE=false

# ─────────────────────────────────────────────────────────────────────────
# 10. MARKET WEBSOCKETS — ON (order-book depth for trap guard)
# ─────────────────────────────────────────────────────────────────────────
ENABLE_MARKET_WEBSOCKETS=true
ENABLE_TRADE_WEBSOCKETS=false
WS_MAX_SYMBOLS=10

# ─────────────────────────────────────────────────────────────────────────
# 11. DATA STORAGE
# ─────────────────────────────────────────────────────────────────────────
DATA_DIR=./data
STORAGE_TOTAL_MAX_MB=2048
STORAGE_DEFAULT_MAX_KB=512
MODEL_MAX_MB=128

# ─────────────────────────────────────────────────────────────────────────
# 12. LOGGING (leave DEBUG off on Wispbyte free tier)
# ─────────────────────────────────────────────────────────────────────────
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────
# 13. EXCHANGE API (Bitget public endpoints — no keys needed for candles;
#     keys only used if you later enable authenticated endpoints)
# ─────────────────────────────────────────────────────────────────────────
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSPHRASE=
