# ═══════════════════════════════════════════════════════════════════════════
# WISPBYTE — WYCKOFF ONLY DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. TELEGRAM ───────────────────────────────────────────────────────────
TELEGRAM_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"
TELEGRAM_POLLING_ENABLED=true
POLLING_TIMEOUT_SEC=30

# ── 2. NEON POSTGRES (PERSISTENT STORAGE) ─────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:NEW_PASSWORD_HERE@ep-broad-cell-b41j71zd-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_FLUSH_INTERVAL_MS=5000
NEON_HYDRATE_ON_BOOT=1

# ── 3. BITGET ─────────────────────────────────────────────────────────────
# Leave blank for read-only market data
BITGET_API_KEY=""
BITGET_API_SECRET=""
BITGET_API_PASSPHRASE=""

# ── 4. ENGINE TOGGLES (WYCKOFF ONLY) ──────────────────────────────────────
WYCKOFF_ENGINE_ENABLED=1
WYCKOFF_SWING_ENGINE_ENABLED=1

# Disable everything else
APEX_ENGINE_ENABLED=0
LIMITBOT_AUTO_ENABLED=0
APEX_SOVEREIGN_ENABLED=0
CONT_ENABLED=0
CONT2_ENABLED=0
AUTO_MAIN_BRAIN_ENABLED=0
VAULT_AUTO_ENABLED=0
DECISION_AUTO_SCAN=false
AUTO_SCANNER_ENABLED=0
BREAKOUT_ENABLED=0
MECH_EXECUTION_ENABLED=0
INSTITUTIONAL_WATCH_INTERVAL_MS=0
KERAS_BRAIN_DISABLED=1
ENABLE_MARKET_WEBSOCKETS=false
ENABLE_TRADE_WEBSOCKETS=false

# ── 5. SCAN FREQUENCY (WYCKOFF ONLY) ──────────────────────────────────────
# Wyckoff is a slow-structure engine. 30 mins is perfect.
WYCKOFF_SCAN_INTERVAL_MS=1800000      # 30 min
WYCKOFF_SCAN_BATCH_SIZE=40            # 40 symbols per cycle
WYCKOFF_SWING_SCAN_INTERVAL_MS=3600000 # 1 hour
WYCKOFF_SWING_SCAN_BATCH_SIZE=30

# ── 6. UNIVERSE & STORAGE LIMITS ──────────────────────────────────────────
MAX_SYMBOLS_WATCH=50
MIN_SYMBOL_VOLUME=10000000            # $10M min volume
LOW_BANDWIDTH_MODE=true

STORAGE_TOTAL_MAX_MB=200
MODEL_MAX_MB=16
STORAGE_DEFAULT_MAX_KB=512

# ── 7. WYCKOFF QUALITY THRESHOLDS ─────────────────────────────────────────
WYCKOFF_MIN_SCORE=82
WYCKOFF_SWING_MIN_SCORE=86
WYCKOFF_TRAP_GUARD_WIRE=1
WYCKOFF_ALLOW_PRE_BREAK_ENTRY=0
WYCKOFF_REQUIRE_MACRO=1
WYCKOFF_TARGET_MODE=deepest_cluster
WYCKOFF_MIN_RR=2.0

# [FAILFAST] Dead coins exclusion (auto-blacklisted, but explicitly listed for boot)
EXCLUDED_SYMBOLS=KORUUSDT,SNXXUSDT,SKHYUSDT,SOXSUSDT,SKHYNIXUSDT,MSTUUSDT,MINIMAXUSDT,NBISUSDT,MUUSDT,BZUSDT,LITEUSDT,GOOGLUSDT,TSLAUSDT,XAGUSDT,NVDAUSDT,SOXLUSDT,JIOUSDT,SNDKUSDT,SAMSUNGUSDT,MSTRUSDT,ZHIPUUSDT,CLUSDT,DRAMUSDT,CRCLUSDT,XAUUSDT,INTCUSDT

# ── 8. ACCOUNT & RISK ─────────────────────────────────────────────────────
ACCOUNT_BALANCE=25
ACCOUNT_RISK_PERCENT=4.0              # $1 risk on a $25 account
DEFAULT_RISK_REWARD=2.5
MARKET_TYPE=futures
FUTURES_LEVERAGE=5.0

# ── 9. HTTP CONTROL & DEBUG ───────────────────────────────────────────────
SERVER_HOST=0.0.0.0
HTTP_CONTROL_TOKEN="" 
EMERGENCY_HALT=0
DEBUG=false
